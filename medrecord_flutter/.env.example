# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini AI Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here

# App Configuration
APP_NAME=MedRecord
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1

# Development Configuration
DEBUG_MODE=true
ENABLE_LOGGING=true

# Firebase Configuration (Optional - for push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# OAuth Configuration
GOOGLE_CLIENT_ID_ANDROID=your_google_oauth_client_id_android
GOOGLE_CLIENT_ID_IOS=your_google_oauth_client_id_ios
GOOGLE_CLIENT_ID_WEB=your_google_oauth_client_id_web

# Storage Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,webp

# API Configuration
API_TIMEOUT_SECONDS=30
MAX_RETRY_ATTEMPTS=3

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
ENABLE_OFFLINE_MODE=true
ENABLE_BIOMETRIC_AUTH=false
ENABLE_DARK_MODE=true